              "range",
              "bucket",
              "points"
            ]
          },
          {
            "path": "/api/dashboard/observe/errors?range=24h&page=1&page_size=30",
            "requiredKeys": [
              "items",
              "total",
              "page",
              "page_size",
              "groups"
            ]
          },
          {
            "path": "/api/dashboard/observe/global_errors/overview?range=24h",
            "requiredKeys": [
              "total",
              "types",
              "new_types",
              "spiking_types"
            ]
          },
          {
            "path": "/api/dashboard/observe/global_errors?range=24h&facet=type&q=",
            "requiredKeys": [
              "total",
              "sections"
            ]
          }
        ]
      }
